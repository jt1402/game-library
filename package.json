{
  "name": "game-library",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute game-library --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute game-library --remote --file schema.sql",
    "import:local": "node scripts/import.mjs --local",
    "import:remote": "node scripts/import.mjs --remote",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
